# ============================================
# WARRANTY PLATFORM — PRODUCTION ENV TEMPLATE
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- Database ---
DATABASE_URL=postgresql://warranty_user:warranty_pass@postgres:5432/warranty
POSTGRES_PASSWORD=warranty_pass

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=warranty-platform-poc
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/warranty-processing-queue

# --- Qdrant (Docker — same EC2, internal network) ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=warranty_chunks
QDRANT_COLLECTION_V2=warranty_chunks_v2

# --- OCR (auto | textract | docling | openai_vision) ---
OCR_METHOD=auto
DOCLING_URL=http://docling:5001

# --- LLMs ---
OPENAI_API_KEY=
SMALL_MODEL=gpt-5.4-mini
LARGE_MODEL=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_LARGE_MODEL=claude-sonnet-4-5-20241022

# --- Contextual retrieval & embeddings ---
ENABLE_CONTEXTUAL_RETRIEVAL=true

# --- Reranker (openai | none) — production uses OpenAI small model, not Cohere ---
ENABLE_RERANKER=true
RERANKER_CANDIDATES=20
RERANKER_PROVIDER=openai

# --- RAG pipeline upgrades (match warranty-platform defaults) ---
ENABLE_PARENT_CHILD=true
ENABLE_STRUCTURED_REASONING=true
ENABLE_RETRIEVAL_QUALITY=true
ENABLE_QUERY_DECOMPOSITION=true
RETRIEVAL_SCORE_THRESHOLD=0.01
RETRIEVAL_MIN_CHUNKS=3
RETRIEVAL_RETRY_TOP_K=50
STRICT_METADATA_FILTERS=false

# --- Auth ---
JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_32
JWT_EXPIRY=24h

# --- Service Ports ---
BACKEND_PORT=3001
AI_SERVICE_PORT=8000

# --- Service URLs (internal docker network) ---
AI_SERVICE_URL=http://ai-service:8000
BACKEND_URL=http://backend:3001

# --- Frontend URL (for CORS) ---
FRONTEND_URL=https://your-app.vercel.app

# --- Optional: Cohere (legacy / unused unless RERANKER_PROVIDER=cohere) ---
COHERE_API_KEY=
